# Anthropic API key used by /api/classify when no key is provided from the UI.
# Get one at https://console.anthropic.com/settings/keys
# Optional — you can also paste a key in the in-app Settings dialog (stored in your browser).
ANTHROPIC_API_KEY=

# Local database (SQLite file by default; swap for a Postgres URL later)
DATABASE_URL=file:./data/app.db

# Login gate. Set AUTH_PASSWORD to require a shared login. The app has no other
# authentication, so a production build (NODE_ENV=production) with NO password
# set FAILS CLOSED — it refuses to serve until you configure one, so data is
# never accidentally exposed. Local dev stays open when unset.
#   AUTH_USERNAME  optional (password-only if unset); non-secret.
#   AUTH_SECRET    signs the session cookie; falls back to AUTH_PASSWORD.
#   AUTH_DISABLED=true  intentionally run open in production (e.g. behind a VPN).
# In production put AUTH_PASSWORD / AUTH_SECRET in real secrets, not a repo file.
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET=
# AUTH_DISABLED=

# Who this instance's accounts belong to — comma-separated names shown in the
# owner dropdowns (a "Joint" option is always added). Defaults to "Person 1,
# Person 2" if unset. Must be prefixed NEXT_PUBLIC_ so it reaches the browser UI.
NEXT_PUBLIC_ACCOUNT_OWNERS=

# Plaid (optional; absent → app is PDF-only)
PLAID_CLIENT_ID=
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US
# Secret per environment (client id is the same for all envs). The app uses
# PLAID_SECRET_<ENV>; PLAID_SECRET is a single-secret fallback for backward compat.
PLAID_SECRET=
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=
# Required only if Plaid is configured — encrypts stored Plaid access tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
